{
  "provider": "openai",
  "api_key": "",
  "base_url": "https://api.deepseek.com",
  "model": "deepseek-chat",
  "max_tokens": 8192,
  "temperature": 0.3,
  "reasoning_effort": "",
  "reasoning_budget_tokens": 0,
  "context_window": 128000,
  "compact_at": 0.8,
  "approval": "ask",
  "sessions_dir": "",
  "shell": "",
  "max_steps": 60,
  "allow_outside": false,
  "web_addr": "127.0.0.1:7777",
  "web_token": "",
  "web_insecure": false,
  "debug": false,
  "mcp_servers": {},
  "hooks": {
    "pre_tool": [
      { "command": "gofmt -l .", "tools": ["write_file", "edit_file"], "timeout_sec": 10 }
    ],
    "post_tool": [
      { "command": "echo hook-finished", "tools": ["bash"], "timeout_sec": 10 }
    ]
  },
  "diagnostics": [
    { "pattern": "*.go", "command": "go vet ./..." }
  ],
  "diagnostic_timeout_sec": 30,
  "editor": {
    "command": "code",
    "args": ["-g", "{file}:{line}"]
  },
  "permissions": [
    { "tool": "bash", "action": "allow", "command": "go test*" },
    { "tool": "bash", "action": "deny", "command": "rm -rf *" },
    { "tool": "write_file", "action": "allow", "path": "docs/**" }
  ],
  "pricing": {
    "deepseek-chat": {
      "input_per_mtok": 0.27,
      "output_per_mtok": 1.1,
      "cache_hit_per_mtok": 0.07
    }
  },
  "instruction_files": [
    "AGENTS.md",
    "CODEAGENT.md",
    ".codedeep/AGENTS.md"
  ]
}
