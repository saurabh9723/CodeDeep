{
  "provider": "openai",
  "api_key": "",
  "base_url": "https://api.deepseek.com",
  "model": "deepseek-chat",
  "max_tokens": 8192,
  "temperature": 0.3,
  "context_window": 128000,
  "compact_at": 0.8,
  "approval": "ask",
  "sessions_dir": "",
  "shell": "",
  "max_steps": 60,
  "allow_outside": false,
  "web_addr": "127.0.0.1:7777",
  "debug": false,
  "mcp_servers": {},
  "permissions": [
    { "tool": "bash", "action": "allow", "command": "go test*" },
    { "tool": "bash", "action": "deny", "command": "rm -rf *" },
    { "tool": "write_file", "action": "allow", "path": "docs/**" }
  ],
  "pricing": {
    "deepseek-chat": {
      "input_per_mtok": 0.27,
      "output_per_mtok": 1.1,
      "cache_hit_per_mtok": 0.07
    }
  },
  "instruction_files": [
    "AGENTS.md",
    "CODEAGENT.md",
    ".codedeep/AGENTS.md"
  ]
}
