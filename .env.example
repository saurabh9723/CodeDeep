# Copy this file to .env and fill in your API key.
#
# CodeDeep loads .env from the current working directory. Real environment
# variables always win over values in this file. Set CODEAGENT_ENV_FILE to
# load a different env file.

# --- Provider ---------------------------------------------------------------
# openai (OpenAI-compatible, including DeepSeek), anthropic, gemini, or ollama.
# CODEAGENT_PROVIDER=openai

# DeepSeek is the default OpenAI-compatible endpoint.
DEEPSEEK_API_KEY=

# Optional overrides. The first configured alias wins:
#   API key:   DEEPSEEK_API_KEY, CODEAGENT_API_KEY, OPENAI_API_KEY
#   Base URL:  DEEPSEEK_BASE_URL, CODEAGENT_BASE_URL, OPENAI_BASE_URL
# CODEAGENT_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# OLLAMA_BASE_URL=http://localhost:11434/v1
# CODEAGENT_MODEL=deepseek-chat

# --- Agent behavior ---------------------------------------------------------
# CODEAGENT_APPROVAL=ask
# CODEAGENT_MAX_STEPS=60
# CODEAGENT_MAX_TOKENS=8192
# CODEAGENT_TEMPERATURE=0.3
# CODEAGENT_CONTEXT_WINDOW=128000
# CODEAGENT_COMPACT_AT=0.8
# CODEAGENT_PROMPT_CACHE=true
# CODEAGENT_REASONING_EFFORT=
# CODEAGENT_REASONING_BUDGET=0
# CODEAGENT_ALLOW_OUTSIDE=false
# CODEAGENT_DEBUG=false

# --- Repo map and symbol index ----------------------------------------------
# Token budget for the codebase map appended to the system prompt. Set to 0 to
# disable prompt injection; the repo_map and find_symbol tools stay available.
# CODEAGENT_REPO_MAP_TOKENS=1200
# CODEAGENT_REPO_MAP_MAX_FILES=5000
# CODEAGENT_REPO_MAP_REFRESH_SEC=2

# --- Paths and web ----------------------------------------------------------
# CODEAGENT_SESSIONS_DIR=
# CODEAGENT_TRACES_DIR=
# CODEAGENT_CONFIG=
# CODEAGENT_MCP_CONFIG=
# CODEAGENT_WEB_ADDR=127.0.0.1:7777
# CODEAGENT_WEB_TOKEN=
# CODEAGENT_WEB_INSECURE=false
# CODEAGENT_DIAGNOSTIC_TIMEOUT=30
# CODEAGENT_SHELL=

# --- Terminal and editor ----------------------------------------------------
# EDITOR=code
# VISUAL=
# NO_COLOR=1
# COLUMNS=100
# TERM=xterm-256color